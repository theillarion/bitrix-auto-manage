# Как создать вебхук, смотрите в docs/setup.md (Часть 1)
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/USER_ID/SECRET/

BITRIX_TIMEZONE=Europe/Moscow

# Путь к SQLite-журналу для host/cron-режима (в Docker задан compose-файлом).
# По умолчанию — .state/operations.sqlite3 относительно каталога запуска;
# укажите абсолютный путь, если запускаете не из корня репо.
# BITRIX_STATE_PATH=/absolute/path/to/operations.sqlite3

# Путь к живому клону SDK — только Docker с override-файлом
# docker-compose.dev.yml (монтируется в /opt/sdk вместо вшитой в образ версии).
# По умолчанию — соседний ../sdk-bitrix-time-manager.
# BITRIX_SDK_PATH=../sdk-bitrix-time-manager

# Тег SDK, вшиваемый в Docker-образ при сборке (build-arg compose).
# По умолчанию v0.2.0; после изменения нужна пересборка (docker compose build).
# BITRIX_SDK_REF=v0.2.0
